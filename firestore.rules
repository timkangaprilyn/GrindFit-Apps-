rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isTrainer() {
      return signedIn() && request.auth.token.trainer == true;
    }

    function isStaff() {
      return isAdmin() || isTrainer();
    }

    function memberRoleOnly(data) {
      return (!('role' in data) || data.role == 'member')
        && !('isAdmin' in data)
        && !('admin' in data);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid)
        && memberRoleOnly(request.resource.data)
        && (!('uid' in request.resource.data)
          || request.resource.data.uid == uid);
      allow update: if isAdmin()
        || (isOwner(uid)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasNone(['role', 'isAdmin', 'admin'])
          && (!('uid' in request.resource.data)
            || request.resource.data.uid == uid));
      allow delete: if isOwner(uid) || isAdmin();

      match /{collection}/{documentId} {
        allow read: if isOwner(uid) || isStaff();
        allow write: if isOwner(uid) || isAdmin();
      }
    }

    match /admin_settings/{documentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
